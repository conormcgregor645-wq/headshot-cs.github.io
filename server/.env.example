# Пример настроек для запуска на своём компьютере: node --env-file=.env app.js
SITE_URL=http://localhost:8080
PORT=8080
DB_PATH=./var/tasher.db
STATIC_DIR=..
STEAM_API_KEY=
OWNER_STEAMIDS=
START_TK=3000
# Только для проверки на своём компьютере: вход без Steam по адресу /auth/dev?steamid=7656119...
DEV_LOGIN=1
# Игровой сервер (необязательно): "Название|адрес для игроков|адрес для опроса", пароль RCON, служба для чтения журнала
# GAME_SERVERS=TASHER Public 5x5|1.2.3.4:27015|127.0.0.1:27015
# GAME_RCON_PASS=
# GAME_LOG_UNIT=cs2.service
# Карты для смены из админки (через запятую); пусто — стандартный список
# GAME_MAPS=de_mirage,de_dust2,de_inferno
